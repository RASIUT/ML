 color_channels]\n\n        # Plot adjusted sample\n        plt.subplot(1, n, i+1)\n        plt.imshow(targ_image_adjusted)\n        plt.axis(\"off\")\n        if classes:\n            title = f\"Class: {classes[targ_label]}\"\n            if display_shape:\n                title = title + f\"\\nshape: {targ_image_adjusted.shape}\"\n\n        plt.title(title)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-18T07:26:03.975314Z","iopub.execute_input":"2025-08-18T07:26:03.975625Z","iopub.status.idle":"2025-08-18T07:26:03.991969Z","shell.execute_reply.started":"2025-08-18T07:26:03.975596Z","shell.execute_reply":"2025-08-18T07:26:03.990991Z"}},"outputs":[],"execution_count":37},{"cell_type":"code","source":"# Display random images from the ImageFolder create Dataset\ndisplay_random_image(train_data,\n                     n=5,\n                     classes=class_names,\n                     seed=None)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-18T07:26:03.992925Z","iopub.execute_input":"2025-08-18T07:26:03.993216Z","iopub.status.idle":"2025-08-18T07:26:04.429884Z","shell.execute_reply.started":"2025-08-18T07:26:03.993189Z","shell.execute_reply":"2025-08-18T07:26:04.429018Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1600x800 with 5 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":38},{"cell_type":"code","source":"# Display random images from the ImageFolderCustom create Dataset\ndisplay_random_image(train_data_custom,\n                     n=20,\n                     classes=class_names,\n                     seed=None)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-18T07:26:04.430911Z","iopub.execute_input":"2025-08-18T07:26:04.431226Z","iopub.status.idle":"2025-08-18T07:26:05.087634Z","shell.execute_reply.started":"2025-08-18T07:26:04.431199Z","shell.execute_reply":"2025-08-18T07:26:05.086781Z"}},"outputs":[{"name":"stdout","text":"For display purposes, n